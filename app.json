{
  "expo": {
    "name": "Safak Sayar",
    "slug": "safak-pro",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tabugoapp.safakpro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Şafak Sayar"
      },
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B0F"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tabugoapp.safakpro",
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C6F432"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 240,
          "backgroundColor": "#0B0B0F",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "./plugins/withAndroidAppName",
        {
          "name": "Şafak Sayar"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c28ab7e6-b8b0-45dd-aea0-4b3f953b4d92"
      }
    },
    "owner": "tabugoapp",
    "backgroundColor": "#0B0B0F"
  }
}
